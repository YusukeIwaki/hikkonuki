---
import Layout from "../../layouts/Layout.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import { playUrl } from "../../site";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const root = `${base}ja/`;
---

<Layout lang="ja" path="" description="Hikkonukiは、カメラの動画・写真をUSBでAndroidに取り込む無料アプリ。DJI Osmo Pocket 4PやInsta360 Ace Pro 2から転送し、対応する4K動画を2Kに変換してギャラリーから共有できます。">
  <div class="cols">
    <div>
      <h1>カメラの動画・写真をUSBでAndroidに取り込む</h1>
      <p class="lead">Hikkonukiは、ジンバルカメラやアクションカメラをUSBケーブルでスマホにつなぎ、動画や写真を取り込む無料のAndroidアプリです。対応する4K動画は2Kに縮めて保存でき、ギャラリーから共有したり、Googleフォトにバックアップしたりできます。</p>
      <p class="lead">できるのはそれだけです。広告も、アカウント登録も、おすすめ動画も、編集機能もありません。インターネットに接続する権限すら持っていません。</p>
      <p class="home-actions">
        <a class="play-badge" href={playUrl}>
          <img src={`${base}play-badge/ja.png`} width="646" height="250" alt="Google Play で手に入れよう" />
        </a>
        <a href={`${root}usb-import/`}>使い方を見る</a>
      </p>

      <h2>カメラ別のUSB取り込みガイド</h2>
      <ul class="plain">
        <li><a href={`${root}osmo-pocket/`}>DJI Osmo Pocket 4Pの動画をAndroidに転送する</a></li>
        <li><a href={`${root}insta360/`}>Insta360 Ace Pro 2の動画をAndroidに転送する</a></li>
      </ul>

      <h2>できること</h2>
      <ul class="plain">
        <li><a href={`${root}usb-import/`}>USB取り込み</a>: カメラをさすと、中の写真と動画が一覧に並びます。カメラをUSBストレージとして、ケーブル経由で読みます。</li>
        <li><a href={`${root}browse/`}>写真・動画を見る</a>: グリッドとリストの切り替え、長押しで複数選択、詳細はスワイプでめくれます。</li>
        <li><a href={`${root}video-slim/`}>2K変換</a>: 対応する4K動画を長辺2560に縮小します。HEVCを優先し、端末が対応していれば10bitのまま書き出します。</li>
        <li><a href={`${root}export/`}>エクスポート</a>: アプリを閉じても続きます。途中でケーブルが抜けても、後始末まで面倒を見ます。</li>
      </ul>

      <h2>流れは3ステップ</h2>
      <table class="spec">
        <tr><th>1. さす</th><td>USB-Cケーブルでカメラとスマートフォンをつなぎます。アプリが開いて、カメラの中身が並びます。</td></tr>
        <tr><th>2. 選ぶ</th><td>タップで1件ずつ確認するか、長押しでまとめて選びます。</td></tr>
        <tr><th>3. エクスポート</th><td>写真はそのままコピーし、対応する4K動画は2Kに変換します。保存先はギャラリーやGoogleフォトから見える <code>DCIM/Hikkonuki</code> です。</td></tr>
      </table>
      <p class="note">名前は「引っこ抜く」から取りました。</p>
    </div>
    <DeviceFrame src={`${base}shots/ja/08_selection.webp`} alt="グリッドで3件を選択し、エクスポートボタンが出ている画面" caption="選んでエクスポートするだけ。動画には長さが出ます。" />
  </div>
</Layout>
