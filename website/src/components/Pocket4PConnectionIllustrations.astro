---
import ConnectionIllustrations from "./ConnectionIllustrations.astro";

interface Props {
  lang: "en" | "ja";
}

const t = {
  en: {
    phone: "Android phone",
    fileTransfer: "File Transfer: USB/OTG",
    webcam: "Webcam",
    cancel: "Cancel",
    connectionLabel: "A USB-C data cable connects the bottom ports of the Android phone and the Osmo Pocket 4P.",
    connectionCaption: "Connect the USB-C data cable to the port on the bottom of the camera.",
    modeLabel: "The camera’s connection menu shows File Transfer: USB/OTG, Webcam, and Cancel. The first option is highlighted.",
    modeCaption: "If the connection menu appears, select File Transfer: USB/OTG at the top.",
  },
  ja: {
    phone: "Androidスマホ",
    fileTransfer: "ファイル転送 / OTG接続",
    webcam: "Webカメラ",
    cancel: "キャンセル",
    connectionLabel: "AndroidスマホとOsmo Pocket 4Pの底面にある端子をUSB-Cケーブルでつなぐ模式図。",
    connectionCaption: "カメラ底面の端子にUSB-Cデータケーブルをつなぎます。",
    modeLabel: "カメラの接続メニューに「ファイル転送 / OTG接続」「Webカメラ」「キャンセル」が縦に並び、一番上が強調されています。",
    modeCaption: "接続メニューが出たら、一番上の「ファイル転送 / OTG接続」を選びます。",
  },
}[Astro.props.lang];
---

<ConnectionIllustrations
  connectionLabel={t.connectionLabel}
  connectionCaption={t.connectionCaption}
  modeLabel={t.modeLabel}
  modeCaption={t.modeCaption}
>
  <Fragment slot="connection">
    <rect class="outline" x="26" y="20" width="59" height="91" rx="10" />
    <rect class="glass" x="32" y="27" width="47" height="77" rx="6" />
    <path class="detail" d="M50 32h11" />
    <path class="cable" d="M55.5 123v2a11 11 0 0 0 11 11H203a11 11 0 0 0 11-11v-2" />
    <rect class="plug" x="50" y="108" width="11" height="6" rx="2" />
    <rect class="plug" x="47" y="112" width="17" height="12" rx="3" />

    <!-- Gimbal head, grip, and bottom USB-C port. -->
    <path class="detail" d="M238 28v11a8 8 0 0 1-8 8h-16" />
    <rect class="outline" x="190" y="14" width="47" height="26" rx="8" />
    <circle class="glass" cx="204" cy="27" r="6" />
    <circle class="glass" cx="222" cy="27" r="6" />
    <rect class="outline" x="185" y="43" width="58" height="68" rx="9" />
    <rect class="glass" x="192" y="50" width="44" height="36" rx="5" />
    <circle class="detail" cx="214" cy="97" r="3.5" />
    <rect class="plug" x="208.5" y="108" width="11" height="6" rx="2" />
    <rect class="plug" x="205.5" y="112" width="17" height="12" rx="3" />

    <text class="device-label" x="55" y="155" text-anchor="middle">{t.phone}</text>
    <text class="cable-label" x="135" y="125" text-anchor="middle">USB-C</text>
    <text class="device-label" x="214" y="155" text-anchor="middle">Osmo Pocket 4P</text>
  </Fragment>

  <Fragment slot="mode">
    <!-- A simplified view of the horizontal screen and its three menu rows. -->
    <rect class="outline" x="116" y="26" width="48" height="128" rx="10" />
    <rect class="outline" x="112" y="13" width="56" height="22" rx="8" />
    <rect class="outline" x="24" y="38" width="232" height="106" rx="14" />
    <rect class="screen" x="32" y="46" width="216" height="90" rx="9" />

    <rect class="selected-mode" x="39" y="53" width="202" height="25" rx="6" />
    <text class="mode-label" x="131" y="71" text-anchor="middle">{t.fileTransfer}</text>
    <path class="check" d="m223 65 4 4 7-8" />

    <rect class="other-mode" x="39" y="83" width="202" height="20" rx="5" />
    <text class="menu-label" x="140" y="97" text-anchor="middle">{t.webcam}</text>
    <rect class="other-mode" x="39" y="108" width="202" height="20" rx="5" />
    <text class="menu-label" x="140" y="122" text-anchor="middle">{t.cancel}</text>
  </Fragment>
</ConnectionIllustrations>
