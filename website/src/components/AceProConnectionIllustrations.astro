---
interface Props {
  lang: "en" | "ja";
}

const t = {
  en: {
    phone: "Android phone",
    usbMenu: "USB Mode",
    diskMode: "U-Disk Mode",
    connectionLabel: "A USB-C cable connects the phone’s bottom port to the camera’s side port.",
    connectionCaption: "Open the camera’s port cover and connect the USB-C data cable.",
    modeLabel: "The upper-left U-Disk Mode option is highlighted in the camera’s USB menu.",
    modeCaption: "Select U-Disk Mode on the camera.",
  },
  ja: {
    phone: "Androidスマホ",
    usbMenu: "USBモード",
    diskMode: "U-Diskモード",
    connectionLabel: "スマホ下部とカメラ側面の端子をUSB-Cケーブルで接続する模式図。",
    connectionCaption: "カメラの端子カバーを開け、USB-Cケーブルでつなぎます。",
    modeLabel: "カメラのUSBメニューの左上にある「U-Diskモード」を強調した模式図。",
    modeCaption: "カメラの画面で「U-Diskモード」を選びます。",
  },
}[Astro.props.lang];
---

<div class="connection-illustrations">
  <figure>
    <svg viewBox="0 0 280 166" width="280" height="166" role="img" aria-label={t.connectionLabel}>
      <!-- Android phone and its bottom-facing connector. -->
      <rect class="outline" x="26" y="20" width="59" height="91" rx="10" />
      <rect class="glass" x="32" y="27" width="47" height="77" rx="6" />
      <path class="detail" d="M50 32h11" />
      <path class="cable" d="M55.5 123v2a11 11 0 0 0 11 11H109a12 12 0 0 0 12-12v-25a14 14 0 0 1 14-14h6" />
      <rect class="plug" x="50" y="108" width="11" height="6" rx="2" />
      <rect class="plug" x="47" y="112" width="17" height="12" rx="3" />

      <!-- A generic rear view, with an open cover above the side port. -->
      <rect class="outline" x="221" y="34" width="22" height="8" rx="3" />
      <rect class="outline" x="155" y="40" width="107" height="72" rx="12" />
      <rect class="glass" x="164" y="49" width="88" height="54" rx="6" />
      <path class="detail" d="M155 70h-10l-11-13" />
      <rect class="outline" x="151" y="76" width="6" height="18" rx="3" />
      <rect class="plug" x="147" y="81" width="7" height="8" rx="2" />
      <rect class="plug" x="135" y="78" width="15" height="14" rx="3" />

      <text class="device-label" x="55" y="155" text-anchor="middle">{t.phone}</text>
      <text class="device-label" x="211" y="134" text-anchor="middle">Ace Pro 2</text>
      <text class="cable-label" x="119" y="154" text-anchor="start">USB-C</text>
    </svg>
    <figcaption>{t.connectionCaption}</figcaption>
  </figure>

  <figure>
    <svg viewBox="0 0 280 166" width="280" height="166" role="img" aria-label={t.modeLabel}>
      <!-- A simplified menu with the relevant option in its upper-left position. -->
      <path class="cable" d="M15 112h17" />
      <rect class="plug" x="25" y="105" width="17" height="14" rx="3" />
      <rect class="outline" x="202" y="20" width="25" height="10" rx="3" />
      <rect class="outline" x="38" y="27" width="208" height="116" rx="17" />
      <rect class="screen" x="47" y="36" width="190" height="98" rx="10" />
      <text class="menu-label" x="59" y="57">{t.usbMenu}</text>

      <rect class="selected-mode" x="56" y="64" width="134" height="32" rx="6" />
      <text class="mode-label" x="66" y="85">{t.diskMode}</text>
      <path class="check" d="m170 80 4 4 7-8" />

      <rect class="other-mode" x="196" y="64" width="32" height="32" rx="6" />
      <rect class="other-mode" x="56" y="102" width="134" height="22" rx="5" />
      <rect class="other-mode" x="196" y="102" width="32" height="22" rx="5" />
    </svg>
    <figcaption>{t.modeCaption}</figcaption>
  </figure>
</div>

<style>
  .connection-illustrations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 225px), 1fr));
    align-items: start;
    gap: 14px;
    margin-block: 14px 20px;
  }
  figure { margin: 0; }
  svg {
    display: block;
    width: 100%;
    height: auto;
    background: #f0f6f5;
    border: 1px solid #dbe8e6;
    border-radius: 12px;
  }
  .outline, .detail, .glass, .screen { stroke: #365653; }
  .outline, .screen { fill: #fff; stroke-width: 2; }
  .glass { fill: #e2eeec; }
  .detail, .cable, .check { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .detail { stroke-width: 2.5; }
  .cable { stroke: #18746d; stroke-width: 4; }
  .plug { fill: #18746d; stroke: #fff; stroke-width: 1; }
  .device-label, .menu-label { fill: #284945; font-size: 12px; font-weight: 650; }
  .cable-label { fill: #095550; font-size: 13px; font-weight: 700; }
  .selected-mode { fill: #095550; }
  .mode-label { fill: #fff; font-size: 15px; font-weight: 700; }
  .check { stroke: #fff; stroke-width: 2.5; }
  .other-mode { fill: #e6eeed; }
</style>
