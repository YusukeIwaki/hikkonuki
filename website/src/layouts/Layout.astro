---
import { playUrl } from "../site";

interface Props {
  lang: "en" | "ja";
  /** Path of this page below the language root, e.g. "" or "browse/". */
  path: string;
  title?: string;
  description: string;
}

const text = {
  en: {
    imageAlt: "Hikkonuki open on an Android phone connected to an action camera by USB.",
    locale: "en_US",
    homeTitle: "Hikkonuki | Import Camera Videos to Android over USB",
    nav: [
      ["usb-import/", "USB import"],
      ["browse/", "Browse"],
      ["video-slim/", "2K conversion"],
      ["export/", "Export"],
    ],
    footer: "Hikkonuki is an Android app. Android 11 or later.",
    privacy: "Privacy Policy",
  },
  ja: {
    imageAlt: "USBでアクションカメラと接続し、Hikkonukiを開いたAndroid端末。",
    locale: "ja_JP",
    homeTitle: "Hikkonuki｜カメラの動画・写真をUSBでAndroidに取り込むアプリ",
    nav: [
      ["usb-import/", "USB取り込み"],
      ["browse/", "写真・動画を見る"],
      ["video-slim/", "2K変換"],
      ["export/", "エクスポート"],
    ],
    footer: "HikkonukiはAndroidアプリです。Android 11以降で動きます。",
    privacy: "プライバシーポリシー",
  },
};

const { lang, path, title } = Astro.props;
const t = text[lang];
const pageTitle = title ? `${title} | Hikkonuki` : t.homeTitle;
const { description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const roots = { en: base, ja: `${base}ja/` };
const root = roots[lang];
const site = new URL(base, Astro.site ?? Astro.url);
const alternate = {
  en: new URL(`${roots.en}${path}`, site).href,
  ja: new URL(`${roots.ja}${path}`, site).href,
};
const pageUrl = alternate[lang];
const imageUrl = new URL(`og/${lang}.png`, site);
const application = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": new URL("#app", site).href,
  name: "Hikkonuki",
  url: pageUrl,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Android 11+",
  downloadUrl: playUrl,
  image: new URL("app-icon-512.png", site).href,
  offers: { "@type": "Offer", price: 0 },
};
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hikkonuki" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={text[lang === "ja" ? "en" : "ja"].locale} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={t.imageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}app-icon-512.png`} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={alternate.en} />
    <link rel="alternate" hreflang="ja" href={alternate.ja} />
    <link rel="alternate" hreflang="x-default" href={alternate.en} />
    <link rel="sitemap" type="application/xml" href={new URL("sitemap-index.xml", site).href} />
    {path === "" && <script is:inline type="application/ld+json" set:html={JSON.stringify(application).replace(/</g, "\\u003c")} />}
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        --ink: #191c1e;
        --sub: #4c545a;
        --line: #d9dde0;
        --accent-ink: #095550;
        --paper: #ffffff;
        --wash: #eef1f2;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--paper);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        line-height: 1.65;
      }
      html[lang="ja"] body {
        font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", "Yu Gothic UI", sans-serif;
        line-height: 1.75;
      }
      a { color: var(--accent-ink); }
      code { font-size: .92em; background: var(--wash); padding: 1px 5px; }
      header.site {
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: var(--paper);
        z-index: 10;
      }
      .bar {
        max-width: 1080px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 12px 28px;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink);
        text-decoration: none;
        letter-spacing: .01em;
      }
      .brand img { width: 26px; height: 26px; border-radius: 6px; display: block; }
      nav.main { display: flex; gap: 6px 18px; flex-wrap: wrap; font-size: .92rem; }
      nav.main a { color: var(--sub); text-decoration: none; }
      nav.main a:hover { color: var(--ink); text-decoration: underline; }
      nav.main a[aria-current="page"] { color: var(--ink); font-weight: 600; }
      .langs { margin-left: auto; display: flex; gap: 12px; font-size: .88rem; }
      .langs a { color: var(--sub); text-decoration: none; }
      .langs a:hover { text-decoration: underline; }
      .langs a[aria-current="true"] { color: var(--ink); font-weight: 600; }
      main { max-width: 1080px; margin: 0 auto; padding: 40px 20px 72px; }
      h1 { font-size: 2rem; line-height: 1.3; margin: 0 0 16px; font-weight: 700; text-wrap: balance; }
      h2 { font-size: 1.3rem; margin: 44px 0 12px; padding-top: 20px; border-top: 1px solid var(--line); }
      h2:first-of-type { border-top: 0; padding-top: 0; }
      p.lead { font-size: 1.08rem; color: var(--sub); max-width: 44em; }
      .cols { display: grid; grid-template-columns: 1.2fr .8fr; gap: 36px; align-items: start; }
      .cols > * { min-width: 0; }
      @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } h1 { font-size: 1.6rem; } }
      figcaption { font-size: .85rem; color: var(--sub); margin-top: 8px; }
      table.spec { border-collapse: collapse; width: 100%; font-size: .94rem; }
      table.spec th, table.spec td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
      table.spec th { background: var(--wash); font-weight: 600; width: 28%; }
      ul.plain { padding-left: 1.2em; }
      ul.plain li { margin: 4px 0; }
      .next { margin-top: 48px; padding: 18px 20px; background: var(--wash); }
      .next p { margin: 4px 0; }
      footer.site { border-top: 1px solid var(--line); }
      footer.site .bar { color: var(--sub); font-size: .88rem; }
      .home-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 16px;
      }
      .play-badge img {
        display: block;
        width: 172px;
        height: auto;
      }
      .note { font-size: .9rem; color: var(--sub); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href={root}><img src={`${base}favicon.svg`} alt="" />Hikkonuki</a>
        <nav class="main">
          {t.nav.map(([href, label]) => (
            <a href={`${root}${href}`} aria-current={href === path ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <div class="langs">
          <a href={`${roots.en}${path}`} lang="en" hreflang="en" aria-current={lang === "en" ? "true" : undefined}>English</a>
          <a href={`${roots.ja}${path}`} lang="ja" hreflang="ja" aria-current={lang === "ja" ? "true" : undefined}>日本語</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="bar">
        <span>{t.footer}</span>
        <a href={`${root}privacy/`} aria-current={path === "privacy/" ? "page" : undefined}>{t.privacy}</a>
      </div>
    </footer>
  </body>
</html>
